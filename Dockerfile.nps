FROM golang:1.26 AS builder
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /go/src/ehang.io/nps
COPY . .
RUN go mod download
RUN CGO_ENABLED=0 go build -ldflags="-w -s -extldflags -static" -o nps ./cmd/nps

FROM scratch
COPY --from=builder /go/src/ehang.io/nps/nps /
VOLUME /conf
CMD ["/nps"]
